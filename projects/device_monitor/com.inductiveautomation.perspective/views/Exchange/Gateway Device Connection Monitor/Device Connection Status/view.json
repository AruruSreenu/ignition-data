{
  "custom": {},
  "params": {
    "labelSize": "14px",
    "tagPath": "",
    "valueSize": "14px"
  },
  "propConfig": {
    "params.labelSize": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.valueSize": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 450
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "DeviceName"
            },
            "position": {
              "basis": "40%",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "tagPath": "{view.params.tagPath}"
                    },
                    "tagPath": "{tagPath}/Name"
                  },
                  "type": "tag"
                }
              },
              "props.textStyle.fontSize": {
                "binding": {
                  "config": {
                    "path": "view.params.labelSize"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "enabled": true,
              "style": {
                "overflow": "hidden"
              },
              "textStyle": {
                "paddingLeft": 5
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "IPAddress"
            },
            "position": {
              "basis": "25%",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "tagPath": "{view.params.tagPath}"
                    },
                    "tagPath": "{tagPath}/Hostname"
                  },
                  "type": "tag"
                }
              },
              "props.textStyle.fontSize": {
                "binding": {
                  "config": {
                    "path": "view.params.labelSize"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "enabled": true,
              "style": {
                "borderLeftStyle": "dashed",
                "borderLeftWidth": 2,
                "borderRightStyle": "dashed",
                "borderRightWidth": 2,
                "overflow": "visible",
                "paddingLeft": 3
              },
              "textStyle": {
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "ConnectionStatusText"
            },
            "position": {
              "basis": "25%",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "tagPath": "{view.params.tagPath}"
                    },
                    "tagPath": "{tagPath}/Connected"
                  },
                  "transforms": [
                    {
                      "fallback": "Error",
                      "inputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "Connected"
                        },
                        {
                          "input": false,
                          "output": "Disconnected"
                        }
                      ],
                      "outputType": "scalar",
                      "type": "map"
                    }
                  ],
                  "type": "tag"
                }
              },
              "props.textStyle.color": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "tagPath1": "{view.params.tagPath}"
                    },
                    "tagPath": "{tagPath1}/Connected"
                  },
                  "transforms": [
                    {
                      "expression": "if ((({value} \u003d false) \u0026\u0026 isgood({value})), \u0027--error\u0027,\u0027--success\u0027)\r\n",
                      "type": "expression"
                    },
                    {
                      "expression": "if({this.props.text} \u003d \u0027Error\u0027, \u0027--error\u0027,{value})",
                      "type": "expression"
                    }
                  ],
                  "type": "tag"
                }
              },
              "props.textStyle.fontSize": {
                "binding": {
                  "config": {
                    "struct": {
                      "error": "{this.props.text}",
                      "valueSize": "{view.params.valueSize}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\tvalueSize \u003d value.valueSize\n\terror \u003d value.error\n\t\n\tif error \u003d\u003d \u0027Error Loading\u0027:\n\t\treturn \u00278px\u0027\n\telse:\n\t\treturn valueSize",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "style": {
                "opacity": 1,
                "overflow": "hidden"
              },
              "textStyle": {
                "fontWeight": "bold",
                "marginRight": 3,
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "ConnectionIcon"
            },
            "position": {
              "basis": "25px",
              "shrink": 0
            },
            "propConfig": {
              "props.color": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "tagPath": "{view.params.tagPath}"
                    },
                    "tagPath": "{tagPath}/Connected"
                  },
                  "transforms": [
                    {
                      "expression": "if ({value}, \u0027--success\u0027, \u0027--error\u0027)",
                      "type": "expression"
                    }
                  ],
                  "type": "tag"
                }
              },
              "props.style.transform": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "tagPath": "{view.params.tagPath}"
                    },
                    "tagPath": "{tagPath}/Connected"
                  },
                  "transforms": [
                    {
                      "expression": "if ({value}, \u0027scale(1,1)\u0027, \u0027scale(-1,-1)\u0027)",
                      "type": "expression"
                    }
                  ],
                  "type": "tag"
                }
              }
            },
            "props": {
              "path": "material/insert_emoticon",
              "style": {
                "classes": "",
                "overflow": "hidden"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "basis": "200px"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "contextMenu": {
        "enabled": true
      },
      "name": "root",
      "tooltip": {
        "delay": 1000,
        "enabled": true
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "fallbackDelay": 2.5,
            "mode": "expression",
            "tagPath": "{view.params.tagPath}+\u0027/Connected.Quality\u0027"
          },
          "transforms": [
            {
              "expression": "concat ({view.params.tagPath} + \u0027  -  \u0027 + \u0027Quality : \u0027 + {value})",
              "type": "expression"
            }
          ],
          "type": "tag"
        }
      }
    },
    "props": {
      "direction": "column",
      "justify": "space-evenly"
    },
    "type": "ia.container.flex"
  }
}